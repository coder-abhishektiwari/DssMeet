# DssMeet — production environment template (Hostinger KVM2 VPS).
#
#   cp .env.production.example .env
#   chmod 600 .env
#   # then fill EVERY value below. docker-compose.prod.yml refuses to start
#   # while any `:?`-marked variable is empty.
#
# Secrets: generate with `openssl rand -hex 32` (JWT/MEDIA/POSTGRES) and
# `openssl rand -hex 16` (TURN_PASS). HEX ONLY — no @ : / # (DATABASE_URL
# and coturn user= both break on those characters).
# NEVER commit the filled .env (root .gitignore already covers it).

# ─────────────────────────── deploy target ───────────────────────────
# KVM2 public IP — hPanel → VPS → Overview. TURN relay candidates break
# without it.
VPS_PUBLIC_IP=1.2.3.4

# Your domain (replace example.com everywhere below).
DOMAIN=example.com

# Hostnames Caddy will serve (must match the DNS A records).
API_HOST=api.example.com
SIGNAL_HOST=signal.example.com
TURN_HOST=turn.example.com

# ─────────────────────────── secrets ───────────────────────────
# openssl rand -hex 32 — SAME value used by backend AND signaling.
JWT_SECRET=

# openssl rand -hex 32 — SAME value used by backend AND signaling
# (control/force-end API: X-API-Key).
MEDIA_API_KEY=

# openssl rand -hex 16 (hex only!) — postgres user password.
POSTGRES_PASSWORD=

# Static TURN credentials for coturn (appended to turnserver.conf at start).
# TURN_PASS: openssl rand -hex 16 (hex only).
TURN_USER=pcturn
TURN_PASS=

# Join-ACK ICE list for signaling — MUST match coturn above (same
# TURN_USER/TURN_PASS, same TURN_HOST). Exact line, edit host+pass only:
TURN_SERVERS=[{"urls":"turn:turn.example.com:3478?transport=udp","username":"pcturn","credential":"CHANGE_ME"},{"urls":"turn:turn.example.com:3478?transport=tcp","username":"pcturn","credential":"CHANGE_ME"}]

# ─────────────────────────── app URLs ───────────────────────────
# Cloudflare Pages origin (apex). Production refuses localhost here.
FAMILY_WEB_URL=https://example.com

# Comma-separated browser origins allowed to call the API — family-web only
# (kiosk/desktop apps send no Origin header and pass regardless).
CORS_ORIGIN=https://example.com

# Handed to kiosks in the create-call response (https://signal.<domain>).
SIGNALING_PUBLIC_URL=https://signal.example.com

# ─────────────────────────── optional tuning ───────────────────────────
ROOM_MAX_PARTICIPANTS=2
DISCONNECT_GRACE_MS=15000

# SMS: keep `log` for the smoke test (OTP is printed in backend logs).
# Before real users: SMS_PROVIDER=fast2sms + fill FAST2SMS_* + set
# SMS_OTP_DOMAIN to the Pages origin (WebOTP @domain must match it).
SMS_PROVIDER=log
SMS_OTP_DOMAIN=example.com
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_OTP_SENDER_ID=
FAST2SMS_LINK_SENDER_ID=
FAST2SMS_SCHEDULED_SENDER_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_LINK_TEMPLATE_ID=
FAST2SMS_SCHEDULED_TEMPLATE_ID=

# Razorpay (wallet/recharge). Leave empty to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────── Cloudflare Pages build env (dashboard, not this file) ───────────────────
# Pages → Settings → Environment variables → Production + Preview:
#   VITE_API_GATEWAY_URL      = https://api.example.com
#   VITE_SIGNALING_URL        = https://signal.example.com
#   VITE_WEBRTC_ICE_SERVERS   = [same JSON as TURN_SERVERS above]
