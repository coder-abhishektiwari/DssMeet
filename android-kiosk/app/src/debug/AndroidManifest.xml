<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug builds point at local/plain-HTTP dev servers (default API is
         http://127.0.0.1:59354). Release keeps the production config where
         cleartext traffic is refused. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />

</manifest>
