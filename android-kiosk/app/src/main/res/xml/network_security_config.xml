<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain> <!-- Android Emulator Loopback -->
    </domain-config>
    <!-- base-config permits cleartext for local docker endpoints
         (127.0.0.1 / 10.0.2.2 / LAN IPs). Flip cleartextTrafficPermitted
         to false here before shipping to production. -->
</network-security-config>
