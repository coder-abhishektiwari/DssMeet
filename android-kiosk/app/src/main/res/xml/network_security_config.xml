<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- PRODUCTION: cleartext (http://) is refused everywhere — API and
         signaling must be reached over HTTPS. Debug builds override this with
         src/debug/res/xml/network_security_config_debug.xml so local/LAN dev
         servers over plain HTTP keep working. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
